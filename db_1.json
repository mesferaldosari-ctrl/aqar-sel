{"projects": [{"id": "seed-maqam-courtyard-17", "name": "مقام كورتيارد 17", "city": "الرياض", "district": "النرجس", "status": "construction", "description": "مشروع سكني فاخر من شركة مقام العقارية في قلب حي النرجس بالرياض، يضم 4 عمائر (A، B، C، D). المساحات تتراوح من 91 إلى 265 م²، والأسعار الاستثمارية تبدأ من 895,000 ريال وتصل إلى 1,424,000 ريال. يبعد دقيقتين عن طريق الملك سلمان، و5 دقائق عن طريق الملك فهد، وقريب من جامعة الأميرة نورة وإكسبو الرياض 2030 والأفنيوز مول ومطار الملك خالد الدولي. يضم مرافق راقية: نوادي رياضية ولاونجات منفصلة للرجال والنساء، حضانة أطفال، مساحات خضراء مشتركة، مواقف خاصة في القبو مع شواحن سيارات كهربائية، أنظمة ذكية وكاميرات مراقبة، وضمانات تصل حتى 15 سنة على العزل المائي والحراري و10 سنوات على الهيكل الإنشائي والمواسير والأدوات الكهربائية. للتواصل: 920001122 - info@maqamco.sa", "units": [{"id": "seed-A1", "unitNumber": "A1", "floor": "الأرضي", "type": "شقة", "area": 91.84, "rooms": 1, "bathrooms": 3, "features": [], "price": "", "status": "sold", "notes": ""}, {"id": "seed-A2", "unitNumber": "A2", "floor": "الأرضي", "type": "شقة", "area": 113.82, "rooms": 2, "bathrooms": 3, "features": [], "price": 1155000, "status": "available", "notes": ""}, {"id": "seed-A3", "unitNumber": "A3", "floor": "الأرضي", "type": "شقة", "area": 97.19, "rooms": 2, "bathrooms": 3, "features": [], "price": "", "status": "sold", "notes": ""}, {"id": "seed-A4", "unitNumber": "A4", "floor": "الأرضي", "type": "شقة", "area": 175.39, "rooms": 3, "bathrooms": 4, "features": [], "price": 1384000, "status": "available", "notes": ""}, {"id": "seed-A5", "unitNumber": "A5", "floor": "الأرضي", "type": "شقة", "area": 117.65, "rooms": 2, "bathrooms": 3, "features": [], "price": 1160000, "status": "available", "notes": ""}, {"id": "seed-A6", "unitNumber": "A6", "floor": "الأول", "type": "شقة", "area": 119.07, "rooms": 2, "bathrooms": 3, "features": [], "price": "", "status": "sold", "notes": ""}, {"id": "seed-A7", "unitNumber": "A7", "floor": "الأول", "type": "شقة", "area": 149.49